# ---------------------------------------------------------------------------
# Server (packages/server/.env)
# ---------------------------------------------------------------------------

# PostgreSQL.
#   DATABASE_URL          -> pooled, used by the server
#   DATABASE_URL_UNPOOLED -> session mode, used only by the migrator (a
#                            transaction pooler cannot hold the advisory lock
#                            the migrator takes)
#
# Supabase (the project this is deployed against). The two strings differ only
# by the port: 6543 is the transaction pooler, 5432 on the same host is session
# mode. The direct host db.<ref>.supabase.co is IPv6 only and many PaaS hosts
# cannot reach it, so both go through the pooler. Get the password from
# Project Settings -> Database -> Connection string.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"
DATABASE_URL_UNPOOLED="postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Neon, if you use that instead: the two strings differ by `-pooler` in the
# host. Keep `?sslmode=require` — Neon refuses plaintext connections.
# DATABASE_URL="postgresql://user:password@ep-xxx-123456-pooler.eu-central-1.aws.neon.tech/bingo?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx-123456.eu-central-1.aws.neon.tech/bingo?sslmode=require"

# Local development: a plain Postgres on the machine is enough, and it is what
# the database-backed tests run against.
# DATABASE_URL="postgresql://bingo:bingo@127.0.0.1:5432/bingo_test"

# JWT signing secrets. Generate with: openssl rand -hex 48
# The two secrets MUST be different: a leaked access secret must not allow
# minting refresh tokens.
AUTH_ACCESS_SECRET="replace-me-with-48-random-bytes-hex"
AUTH_REFRESH_SECRET="replace-me-with-another-48-random-bytes-hex"

# Token lifetimes
AUTH_ACCESS_TTL_SECONDS="900"
AUTH_REFRESH_TTL_SECONDS="2592000"

NODE_ENV="development"
HOST="0.0.0.0"
# API, matchmaking and WebSockets all share this port. A PaaS exposes exactly
# one port per service, which is why they are not split.
PORT="3001"
LOG_LEVEL="info"

# Comma separated list of allowed browser origins for CORS.
CLIENT_ORIGINS="http://localhost:5173"

# Credits granted to a brand new account (welcome bonus, ledger entry).
WELCOME_BONUS_CREDITS="1000"

# ---------------------------------------------------------------------------
# Client (packages/client/.env)
# ---------------------------------------------------------------------------

VITE_API_URL="http://localhost:3001"
