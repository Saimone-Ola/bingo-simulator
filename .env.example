# ---------------------------------------------------------------------------
# Server (packages/server/.env)
# ---------------------------------------------------------------------------

# Neon PostgreSQL connection string (pooled connection works for the API,
# migrations should run against the direct/unpooled one).
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/bingo?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/bingo?sslmode=require"

# JWT signing secrets. Generate with: openssl rand -hex 48
# The two secrets MUST be different: a leaked access secret must not allow
# minting refresh tokens.
AUTH_ACCESS_SECRET="replace-me-with-48-random-bytes-hex"
AUTH_REFRESH_SECRET="replace-me-with-another-48-random-bytes-hex"

# Token lifetimes
AUTH_ACCESS_TTL_SECONDS="900"
AUTH_REFRESH_TTL_SECONDS="2592000"

NODE_ENV="development"
HOST="0.0.0.0"
PORT="3001"
LOG_LEVEL="info"

# Comma separated list of allowed browser origins for CORS.
CLIENT_ORIGINS="http://localhost:5173"

# Credits granted to a brand new account (welcome bonus, ledger entry).
WELCOME_BONUS_CREDITS="1000"

# ---------------------------------------------------------------------------
# Client (packages/client/.env)
# ---------------------------------------------------------------------------

VITE_API_URL="http://localhost:3001"
VITE_WS_URL="ws://localhost:2567"
