# The server puts the API, matchmaking and WebSockets on one port, so this is
# the only URL the client needs. In production it is the https:// URL of the
# deployed server; the client derives wss:// from it.
VITE_API_URL="http://localhost:3001"

# Optional override, only if the game server sits behind a different hostname
# than the API.
# VITE_WS_URL="wss://bingo-server.example.com"
