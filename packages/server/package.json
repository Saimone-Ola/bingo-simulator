{
  "name": "@bingo/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup && node scripts/emit-runtime-manifest.mjs",
    "start": "node index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "db:check": "tsx --env-file-if-exists=.env scripts/check-ledger-integrity.ts",
    "load:hub": "tsx --env-file-if-exists=.env scripts/load-hub.ts"
  },
  "dependencies": {
    "@bingo/shared": "workspace:*",
    "@colyseus/schema": "^4.0.30",
    "argon2": "^0.45.1",
    "colyseus": "^0.17.10",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "jose": "^6.2.4",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.17.43",
    "@colyseus/testing": "^0.17.11",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tsup": "^8.5.0",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
